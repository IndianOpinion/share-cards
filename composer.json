{
    "name": "indianopinion/share-cards",
    "description": "Social share cards for WordPress, rendered on the first request and served from disk, with GD or Imagick and a content hash in the URL.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "open-graph", "og-image", "share-card", "gd", "imagick"],
    "homepage": "https://github.com/IndianOpinion/share-cards",
    "support": {
        "email": "hello@indianopinion.org",
        "issues": "https://github.com/IndianOpinion/share-cards/issues"
    },
    "authors": [
        {"name": "Indian Opinion", "email": "hello@indianopinion.org"}
    ],
    "require": {
        "php": ">=8.1",
        "ext-gd": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-imagick": "Alternative renderer, and the Pango text layer for complex scripts when ImageMagick has the Pango delegate",
        "ext-intl": "Unicode NFC normalisation of card text"
    },
    "autoload": {
        "psr-4": {"IndianOpinion\\ShareCards\\": "src/"},
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {"IndianOpinion\\ShareCards\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "platform": {"php": "8.1.0"}
    },
    "minimum-stability": "stable",
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    }
}
